# Neon Postgres connection string (create one at https://neon.new).
# The Cloudflare worker runtime reads .dev.vars locally (NOT .env/.env.local),
# and `wrangler secret put` in production. The CLI scripts (apply-schema,
# seed:people) read DATABASE_URL from .env.local.
DATABASE_URL=
DATABASE_URL_POOLER=

# JWT signing secret — any long random string in dev.
AUTH_SECRET=

# Resend email (https://resend.com). Email is best-effort; leave unset to disable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Base URL used in email links (e.g. https://quorq.saitezz-m12.in).
APP_URL=
